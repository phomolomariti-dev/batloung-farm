# Server
PORT=5000
NODE_ENV=development

# MySQL (never commit the real .env)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=batloung_farm
DB_SSL=false

# Business settings
LOW_STOCK_THRESHOLD=10

# Delivery / map settings (depot = Batloung Farm, Maseru)
DEPOT_LAT=-29.3167
DEPOT_LNG=27.4833
AVG_SPEED_KMH=40
ROAD_FACTOR=1.35
HANDLING_MINUTES=10

# Supplier trips (Maseru -> South Africa)
SUPPLIER_SPEED_KMH=80
SUPPLIER_ROAD_FACTOR=1.25
BORDER_MINUTES=60
TRIP_COST_PER_KM=5
TRIP_FIXED_COST=300
LOADING_MINUTES=45
